<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:background="#1A1A2E"
    android:orientation="vertical">

    <!-- Main area: mic button + hint + timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.murmur.keyboard.ui.MicButtonView
            android:id="@+id/mic_button"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tap to speak"
            android:textColor="#B0B0C3"
            android:textSize="15sp"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0C3"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom button strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#16213E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4">

        <ImageButton
            android:id="@+id/btn_globe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/ripple_btn_bar"
            android:src="@drawable/ic_globe"
            android:scaleType="center"
            android:contentDescription="Switch keyboard" />

        <ImageButton
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:background="@drawable/ripple_btn_bar"
            android:src="@drawable/ic_space"
            android:scaleType="center"
            android:contentDescription="Space" />

        <ImageButton
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/ripple_btn_bar"
            android:src="@drawable/ic_backspace"
            android:scaleType="center"
            android:contentDescription="Backspace" />

        <ImageButton
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/ripple_btn_bar"
            android:src="@drawable/ic_enter"
            android:scaleType="center"
            android:contentDescription="Enter" />

    </LinearLayout>

</LinearLayout>
